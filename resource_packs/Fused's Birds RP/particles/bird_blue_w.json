{
  "format_version": "1.21.60",
  "particle_effect": {
    "description": {
      "identifier": "fused:bird_blue_w",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/bird_blue"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.dir_x = -1; v.dir_z = 0; v.spin = -90;"
      },
      "minecraft:emitter_rate_manual": {
        "max_particles": 12
      },
      "minecraft:emitter_lifetime_expression": {
        "activation_expression": 1,
        "expiration_expression": 0
      },
      "minecraft:emitter_shape_point": {
        "offset": [0.0, "math.random(-1.5,2)", 0.0]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(35,50)"
      },
      "minecraft:particle_initial_speed": 5,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "1.5*v.dir_x",
          //first num is jitter magnitude
          "2.5 * (math.mod(math.floor(variable.particle_age * 4), 2) * 2 - 1)",
          "1.5*v.dir_z"
        ],
        "linear_drag_coefficient": 0.7
      },
      "minecraft:particle_initial_spin": {
        "rotation": "v.spin"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.18 * math.min(1, variable.particle_age) * math.min(1, (variable.particle_lifetime - variable.particle_age) / 4)",
          "0.18 * math.min(1, variable.particle_age) * math.min(1, (variable.particle_lifetime - variable.particle_age) / 4)"
        ],
        "facing_camera_mode": "emitter_transform_xz",
        "uv": {
          "texture_width": 64,
          "texture_height": 16,
          "uv": [
            //second last num is frames
            "(16 * math.floor(math.mod(variable.particle_age * 13, 4)))",
            0
          ],
          "uv_size": [16, 16]
        }
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:particle_expire_if_not_in_blocks": ["minecraft:air"]
    }
  }
}
