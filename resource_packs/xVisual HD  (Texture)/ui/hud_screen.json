/*
 - Special thanks to @bakedpotato~ for being a very massive part of this new stable system!
*/
{
  "namespace": "hud",

  "chat_grid_item/chat_background": {
    // Used to hide specific messages from the hud screen chat.
    "bindings": [
      {
        "binding_type": "collection",
        "binding_name": "#chat_text",
        "binding_name_override": "#text",
        "binding_collection_name": "chat_text_grid"
      },
      {
        "binding_type": "view",
        "source_property_name": "(§z + #text)",
        "target_property_name": "#new_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#text = '') or ((#new_text - 'xVisWeakDamage' - 'xVisHardDamage' - 'xVisStrongDamage' - 'xVisImpact0' - 'xVisImpactFixed1' - 'xVisImpactFixed2' - 'xVisImpactFixed3' - 'xVisImpact4' - 'xVisImpact5' - 'xVisImpact6' - 'xVisImpact7' - 'xVisImpact8' - 'xVisImpact9' - 'xVisImpact10' - 'xVisImpact11' - 'xVisImpact12' - 'xVisImpact13' - 'xVisImpact14' - 'xVisImpact15' - 'xVisImpact16' - 'xVisImpact17' - 'xVisImpact18' - 'xVisImpact19' - 'xVisImpact20' - 'xVisImpact21' - 'xVisImpact22' - 'xVisImpact23' - 'xVisImpact24' - 'xVisImpact25' - 'xVisImpact26' - 'xVisImpact27' - 'xVisImpact28' - 'xVisImpact29' - 'xVisImpact30' - 'xVisImpact31' - 'xVisImpact32' - 'xVisImpact33' - 'xVisFlameImpact0' - 'xVisFlameImpact1' - 'xVisFlameImpact2' - 'xVisFlameImpact3' - 'xVisFlameImpact4' - 'xVisFlameImpact5' - 'xVisFlameImpact6' - 'xVisFlameImpact7' - 'xVisDrowning0' - 'xVisDrowningFixed1' - 'xVisDrowning2' - 'xVisDrowning3' - 'xVisDrowning4' - 'xVisDrowning5' - 'xVisDrowning6' - 'xVisDrowning7' - 'xVisDrowning8' - 'xVisDrowning9' - 'xVisDrowning10' - 'xVisDrowning11' - 'xVisDrowning12' - 'xVisDrowning13' - 'xVisDrowning14' - 'xVisDrowning15' - 'xVisDrowning16' - 'xVisWeakExplosion' - 'xVisHardExplosion' - 'xVisStrongExplosion' - 'xVisLowHealth0Blur' - 'xVisFalseLowHealth0Blur' - 'xVisLowHealth1Blur' - 'xVisFalseLowHealth1Blur' - 'xVisPoison' - 'xVisFireResistance' - 'xVisResistance' - 'xVisRegeneration' - 'xVisSlowFalling' - 'xVisSpeed' - 'xVisStrength' - 'xVisSlowness' - 'xVisJumpBoost' - 'xVisNightVision' - 'xVisInvisibility' - 'xVisWaterBreathing' - 'xVisWeakness' - 'xVisWither' - 'xVisLevitation' - 'xVisWindCharged' - 'xVisWeaving' - 'xVisOozing' - 'xVisInfested') = #new_text))",
        "target_property_name": "#visible" // The message will not be visible if it was included here.
      }
    ]
  },

  "loop_offset": { "anim_type": "offset", "duration": 1, "from": [0, "-100%c"], "to": [0, "-100%c"], "next": "@hud.loop_offset" }, // Required to make the stack factory works.

  "loop_size0": { "anim_type": "size", "duration": 0.05, "from": ["100%", 0], "to": ["100%", 0], "next": "@hud.loop_size1" },
  "loop_size1": { "anim_type": "size", "duration": 0, "from": ["100%", 0], "to": ["100%", "100%"] },

  "image_hider_anim": { "anim_type": "wait", "duration": 0, "destroy_at_end": "chat_grid_item" }, // Used to hide the images by destroying the Chat-Message.
  "image_hider_panel": { "type": "panel", "anims": ["@image_hider_anim"] }, // Used to run the image hider animation.

  "weak_damage_in": {
    // Making the image fade in.
    "anim_type": "alpha", // Changing the image transparency.
    "easing": "linear", // Making the animation smoother and more stable.
    "duration": 0.1, // In 0.1s.
    "from": 0,
    "to": 0.5,
    "next": "@hud.weak_damage_out"
  },
  "weak_damage_out": {
    // Making the image fade out.
    "anim_type": "alpha",
    "easing": "linear",
    "duration": 0.3,
    "from": 0.5,
    "to": 0,
    "destroy_at_end": "chat_grid_item" // Destroy the image when the animation is finished.
  },
  "hard_damage_in": { "anim_type": "alpha", "easing": "linear", "duration": 0.1, "from": 0, "to": 0.7, "next": "@hud.hard_damage_out" },
  "hard_damage_out": { "anim_type": "alpha", "easing": "linear", "duration": 0.4, "from": 0.7, "to": 0, "destroy_at_end": "chat_grid_item" },

  "strong_damage_in": { "anim_type": "alpha", "easing": "linear", "duration": 0.1, "from": 0, "to": 1, "next": "@hud.strong_damage_out" },
  "strong_damage_out": { "anim_type": "alpha", "easing": "linear", "duration": 0.5, "from": 1, "to": 0, "destroy_at_end": "chat_grid_item" },

  "impact0_in": { "anim_type": "alpha", "easing": "linear", "duration": 0.2, "from": 0, "to": 0.9, "next": "@hud.impact0_out" },
  "impact0_out": { "anim_type": "alpha", "easing": "linear", "duration": 17.4, "from": 0.9, "to": 0, "destroy_at_end": "chat_grid_item" },

  "impact1_in": { "anim_type": "alpha", "easing": "linear", "duration": 0.2, "from": 0, "to": 0.9, "next": "@hud.impact1_out" },
  "impact1_out": { "anim_type": "alpha", "easing": "linear", "duration": 26.1, "from": 0.9, "to": 0, "destroy_at_end": "chat_grid_item" },

  "flame_impact_in": { "anim_type": "alpha", "easing": "linear", "duration": 0.2, "from": 0, "to": 1, "next": "@hud.flame_impact_out" },
  "flame_impact_out": { "anim_type": "alpha", "easing": "linear", "duration": 16.2, "from": 1, "to": 0, "destroy_at_end": "chat_grid_item" },

  "drowning_in": { "anim_type": "alpha", "easing": "linear", "duration": 0.2, "from": 0, "to": 0.8, "next": "@hud.drowning_out" },
  "drowning_out": { "anim_type": "alpha", "easing": "linear", "duration": 11.8, "from": 0.8, "to": 0, "destroy_at_end": "chat_grid_item" },

  "weak_explosion_blur_in": { "anim_type": "alpha", "easing": "linear", "duration": 0.1, "from": 0, "to": 0.7, "next": "@hud.weak_explosion_blur_out" },
  "weak_explosion_blur_out": { "anim_type": "alpha", "easing": "linear", "duration": 3.8, "from": 0.7, "to": 0, "destroy_at_end": "chat_grid_item" },

  "hard_explosion_blur_in": { "anim_type": "alpha", "easing": "linear", "duration": 0.1, "from": 0, "to": 0.8, "next": "@hud.hard_explosion_blur_out" },
  "hard_explosion_blur_out": { "anim_type": "alpha", "easing": "linear", "duration": 5.1, "from": 0.8, "to": 0, "destroy_at_end": "chat_grid_item" },

  "strong_explosion_blur_in": { "anim_type": "alpha", "easing": "linear", "duration": 0.1, "from": 0, "to": 0.9, "next": "@hud.strong_explosion_blur_out" },
  "strong_explosion_blur_out": { "anim_type": "alpha", "easing": "linear", "duration": 8.4, "from": 0.9, "to": 0, "destroy_at_end": "chat_grid_item" },

  "weak_explosion_in": { "anim_type": "alpha", "easing": "linear", "duration": 0.1, "from": 0, "to": 0.3, "next": "@hud.weak_explosion_out" },
  "weak_explosion_out": { "anim_type": "alpha", "easing": "linear", "duration": 17.3, "from": 0.3, "to": 0, "destroy_at_end": "chat_grid_item" },

  "hard_explosion_in": { "anim_type": "alpha", "easing": "linear", "duration": 0.1, "from": 0, "to": 0.5, "next": "@hud.hard_explosion_out" },
  "hard_explosion_out": { "anim_type": "alpha", "easing": "linear", "duration": 21.5, "from": 0.5, "to": 0, "destroy_at_end": "chat_grid_item" },

  "strong_explosion_in": { "anim_type": "alpha", "easing": "linear", "duration": 0.3, "from": 0, "to": 0.7, "next": "@hud.strong_explosion_out" },
  "strong_explosion_out": { "anim_type": "alpha", "easing": "linear", "duration": 29.7, "from": 0.7, "to": 0, "destroy_at_end": "chat_grid_item" },

  "low_health0_in": { "anim_type": "alpha", "easing": "linear", "duration": 0.4, "from": 0, "to": 0.4 },

  "low_health0_blur_in": { "anim_type": "alpha", "easing": "linear", "duration": 0.8, "from": 0, "to": 0, "next": "@hud.low_health0_blur_loop" },
  "low_health0_blur_loop": { "anim_type": "alpha", "easing": "linear", "duration": 0.7, "from": 0.5, "to": 0, "next": "@hud.low_health0_blur_in" },

  "low_health0_out": { "anim_type": "alpha", "easing": "linear", "duration": 2, "from": 0.6, "to": 0, "destroy_at_end": "chat_grid_item" },

  "low_health1_in": { "anim_type": "alpha", "easing": "linear", "duration": 0.4, "from": 0, "to": 0.6 },

  "low_health1_blur_in": { "anim_type": "alpha", "easing": "linear", "duration": 1, "from": 0, "to": 0, "next": "@hud.low_health1_blur_b0" },
  "low_health1_blur_b0": { "anim_type": "alpha", "easing": "linear", "duration": 0.4, "from": 0.9, "to": 0.4, "next": "@hud.low_health1_blur_loop" },
  "low_health1_blur_loop": { "anim_type": "alpha", "easing": "linear", "duration": 0.6, "from": 0.9, "to": 0, "next": "@hud.low_health1_blur_in" },

  "low_health1_out": { "anim_type": "alpha", "easing": "linear", "duration": 2, "from": 0.6, "to": 0, "destroy_at_end": "chat_grid_item" },

  "effected_in": { "anim_type": "alpha", "easing": "linear", "duration": 0.3, "from": 0, "to": 0.7, "next": "@hud.effected_out" },
  "effected_out": { "anim_type": "alpha", "easing": "linear", "duration": 6, "from": 0.7, "to": 0, "destroy_at_end": "chat_grid_item" },
  "positive_effects_in": { "anim_type": "alpha", "easing": "linear", "duration": 0.3, "from": 0, "to": 0.4, "next": "@hud.positive_effects_out" },
  "positive_effects_out": { "anim_type": "alpha", "easing": "linear", "duration": 6, "from": 0.4, "to": 0, "destroy_at_end": "chat_grid_item" },

  "slowness_arrows_in": { "anim_type": "uv", "easing": "linear", "duration": 1.6, "from": [0, 2048], "to": [0, 0], "destroy_at_end": "chat_grid_item" },
  "levitation_arrows_in": { "anim_type": "uv", "easing": "linear", "duration": 1.6, "from": [0, 0], "to": [0, 2048], "destroy_at_end": "chat_grid_item" },

  "weak_damage_panel": {
    // All other images use the same method as this one.
    "type": "panel",
    "anchor_from": "center",
    "anchor_to": "center",
    "layer": 12,
    "size": "@hud.loop_size0", // Applying the size via animations to fix the flickering issue.
    "controls": [
      {
        "weak_damage_image": {
          "type": "image",
          "texture": "textures/ui/damaged/damaged",
          "alpha": "@weak_damage_in", // Applying the alpha (transparency) animation.
          "bindings": [
            {
              "binding_type": "view",
              "source_property_name": "('@' + #text - 'xVisWeakDamageHider:unused' - 'xVisWeakDamage' = '@' + #text)",
              "target_property_name": "#destroy" // Hiding the image only when the sent Chat-Message matches 'xVisWeakDamageHider:unused', since this image is temporary, we don't have to hide it because the animations will do that by default.
            },
            {
              "binding_type": "view",
              "source_property_name": "(not #destroy and not ('@' + #text - 'xVisWeakDamage' = '@' + #text))",
              "target_property_name": "#visible" // The image is not visible by default, and it will be visible only when the sent Chat-Message matches 'xVisWeakDamage'.
            }
          ]
        }
      },
      {
        "weak_damage_hide": {
          "type": "collection_panel",
          "size": [0, 0],
          "factory": { "name": "empty", "control_name": "hud.image_hider_panel" }, // Triggering the image hider panel.
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "weak_damage_image",
              "source_property_name": "(#destroy * 1)",
              "target_property_name": "#collection_length",
              "resolve_sibling_scope": true
            }
          ]
        }
      }
    ]
  },
  "weak_damage_factory": {
    "type": "panel",
    "controls": [
      {
        "weak_damage_sfactory": {
          "type": "stack_panel", // Making the factory stack the same image instead of generate a new one (better performance).
          "size": ["100%", "100%"],
          "offset": "@hud.loop_offset", // Requred to make the stack factory work.
          "anchor_from": "bottom_middle",
          "anchor_to": "top_middle",
          "factory": { "name": "chat_item_factory", "max_children_size": 6, "control_ids": { "chat_item": "hud.weak_damage_panel" } } // Max children size is used to limit the amount of images the factory can generate.
        }
      }
    ]
  },

