         { "27@customarmor.render_empty": { "offset": [72, 0], "$i": 20 } },
         { "28@customarmor.render_full": { "offset": [72, 0], "$i": 20 } },
         { "29@customarmor.render_half": { "offset": [72, 0], "$i": 19 } }
      ]
   },

   "custom_armor_factory_clasic": {
      "type": "panel",
      "factory": {
         "name": "hud_actionbar_text_factory",
         "control_ids": {
            "hud_actionbar_text": "custom_armor_panel_clasic@customarmor.custom_armor_panel_clasic"
         }
      }
   },

