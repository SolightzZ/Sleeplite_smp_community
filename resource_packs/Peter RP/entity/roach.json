        "default": "spider"
      },
      "textures": {
        "default": "textures/entity/roach"
      },
      "geometry": {
        "default": "geometry.roach"
      },
      "animations": {
        "walk": "animation.roach.walk",
        "idle": "animation.roach.tentacle_shake",
        "befly": "animation.roach.befly",
        "fly": "animation.roach.fly",
        "ac": "controller.animation.roach"
      },
      "scripts": {
        "pre_animation": [
          "v.fly=!query.is_on_ground;",
          "v.walk=q.modified_move_speed>0.01;"
