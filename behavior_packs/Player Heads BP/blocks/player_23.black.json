{
  "format_version": "1.21.80",
  "minecraft:block": {
    "description": {
      "identifier": "bluefirefroggy:player_head_23_block",
      "menu_category": {
        "category": "none",
        "is_hidden_in_commands": true
      },
      "traits": {
        "minecraft:placement_position": {
          "enabled_states": ["minecraft:block_face"]
        }
      },
      "states": {
        "bluefirefroggy:head_rotation": {
          "values": {
            "min": 0,
            "max": 15
          }
        }
      }
    },
    "components": {
      "minecraft:liquid_detection": {
        "detection_rules": [
          {
            "can_contain_liquid": true
          }
        ]
      },
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 1.5
      },
      "minecraft:collision_box": {
        "origin": [-4, 0, -4],
        "size": [8, 8, 8]
      },
      "minecraft:selection_box": {
        "origin": [-4, 0, -4],
        "size": [8, 8, 8]
      },
      "minecraft:geometry": {
        "identifier": "geometry.bluefirefroggy_player_head",
        "bone_visibility": {
          "up_0": "query.block_state('minecraft:block_face') == 'up' && math.mod(query.block_state('bluefirefroggy:head_rotation'), 4) == 0",
          "up_22_5": "query.block_state('minecraft:block_face') == 'up' && math.mod(query.block_state('bluefirefroggy:head_rotation'), 4) == 1",
          "up_45": "query.block_state('minecraft:block_face') == 'up' && math.mod(query.block_state('bluefirefroggy:head_rotation'), 4) == 2",
          "up_67_5": "query.block_state('minecraft:block_face') == 'up' && math.mod(query.block_state('bluefirefroggy:head_rotation'), 4) == 3",
          "side": "query.block_state('minecraft:block_face') != 'up'"
        }
      },
      "minecraft:custom_components": ["bluefirefroggy:rotation_comp"],
      "minecraft:material_instances": {
        "*": {
          "texture": "player23",
          "ambient_occlusion": false,
          "render_method": "alpha_test"
        },
        "outer_head": {
          "texture": "player23",
          "ambient_occlusion": false,
          "render_method": "alpha_test"
        }
      },
      "minecraft:destruction_particles": {
        "texture": "soul_sand"
      },
      "minecraft:light_dampening": 0,
      "minecraft:placement_filter": {
        "conditions": [
          {
            "allowed_faces": ["up", "side"]
          }
        ]
      }
    },
    "permutations": [
      {
        "condition": "query.block_state('bluefirefroggy:head_rotation') >= 4 || query.block_state('minecraft:block_face') == 'east'",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, -90, 0]
          }
        }
      },
      {
        "condition": "query.block_state('bluefirefroggy:head_rotation') >= 8 || query.block_state('minecraft:block_face') == 'south'",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, 180, 0]
          }
        }
      },
      {
        "condition": "query.block_state('bluefirefroggy:head_rotation') >= 12 || query.block_state('minecraft:block_face') == 'west'",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, 90, 0]
          }
        }
      },
      {
        "condition": "query.block_state('minecraft:block_face') != 'up'",
        "components": {
          "minecraft:collision_box": {
            "origin": [-4, 4, 0],
            "size": [8, 8, 8]
          },
          "minecraft:selection_box": {
            "origin": [-4, 4, 0],
            "size": [8, 8, 8]
          }
        }
      }
    ]
  }
}
