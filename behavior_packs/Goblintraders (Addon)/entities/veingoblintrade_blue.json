{
  "format_version": "1.13.0",
  "minecraft:entity": {
    "description": {
      "identifier": "goblin:veingoblintrader_blue",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "spawn_category": "ambient"
    },
    "component_groups": {
      "move": {
        "minecraft:movement": {
          "value": 0.3
        },
        "minecraft:movement.basic": {},
        "minecraft:navigation.walk": {
          "can_path_over_water": true,
          "avoid_damage_blocks": true
        },
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "on_damage": {
                "event": "fall_down_animation_event"
              },
              "deals_damage": true
            }
          ]
        },
        "minecraft:behavior.random_stroll": {
          "priority": 6,
          "speed_multiplier": 1
        }
      },
      "look": {
        "minecraft:behavior.look_at_target": {
          "priority": 4,
          "look_distance": 7,
          "probability": 1
        },
        "minecraft:behavior.look_at_player": {
          "priority": 4,
          "look_distance": 7
        }
      },
      "start_eating": {
        "minecraft:timer": {
          "time": 1.3,
          "looping": false,
          "time_down_event": {
            "event": "eat_carrot_event",
            "target": "self"
          }
        }
      },
      "fall_down_animation": {
        "minecraft:timer": {
          "time": 1.29,
          "looping": false,
          "time_down_event": {
            "event": "stand_up_event",
            "target": "self"
          }
        },
        "minecraft:is_illager_captain": {}
      },
      "fall_down_animation_2": {
        "minecraft:timer": {
          "time": 1.29,
          "looping": false,
          "time_down_event": {
            "event": "stand_up_event",
            "target": "self"
          }
        },
        "minecraft:is_ignited": {}
      },
      "eat_carrot": {
        "minecraft:is_sheared": {},
        "minecraft:timer": {
          "time": 1,
          "looping": false,
          "time_down_event": {
            "event": "stop_eating",
            "target": "self"
          }
        }
      }
    },
    "components": {
      "minecraft:equipment": {
        "table": "loot_tables/equipment/goblin_equipment_random.json"
      },
      "minecraft:economy_trade_table": {
        "display_name": "entity.veingoblintrader.name",
        "table": "trading/vein_globin_trades/trades.json",
        "new_screen": true,
        "persist_trades": true
      },
      "minecraft:loot": {
        "table": "loot_tables/veingoblintrader.json"
      },
      "minecraft:health": {
        "value": 20
      },
      "minecraft:behavior.tempt": {
        "priority": 0,
        "speed_multiplier": 1,
        "items": ["minecraft:carrot"]
      },
      "minecraft:behavior.pickup_items": {
        "priority": 1,
        "max_dist": 16,
        "goal_radius": 1,
        "speed_multiplier": 0.9
      },
      "minecraft:shareables": {
        "all_items_max_amount": 1,
        "items": [
          {
            "item": "minecraft:carrot",
            "priority": 0,
            "max_amount": 1
          }
        ]
      },
      "minecraft:leashable": {
        "soft_distance": 4,
        "hard_distance": 6,
        "max_distance": 10
      },
      "minecraft:type_family": {
        "family": ["goblin", "player"]
      },
      "minecraft:collision_box": {
        "width": 0.5,
        "height": 0.5
      },
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:nameable": {},
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": ["move", "look"]
        }
      },
      "fall_down_animation_event": {
        "randomize": [
          {
            "weight": 5,
            "add": {
              "component_groups": ["fall_down_animation"]
            },
            "remove": {
              "component_groups": ["look"]
            },
            "queue_command": {
              "command": ["effect @s slowness 3 255 true"]
            }
          },
          {
            "weight": 5,
            "add": {
              "component_groups": ["fall_down_animation_2"]
            },
            "remove": {
              "component_groups": ["look"]
            },
            "queue_command": {
              "command": ["effect @s slowness 3 255 true"]
            }
          }
        ]
      },
      "stand_up_event": {
        "remove": {
          "component_groups": ["fall_down_animation", "fall_down_animation_2"]
        },
        "add": {
          "component_groups": ["look", "start_eating"]
        },
        "queue_command": {
          "command": ["damage @p[r=3,m=s] 2 entity_attack entity @s", "playsound goblin_trader_annoyed @a[r=10,m=s]"]
        }
      },
      "eat_carrot_event": {
        "add": {
          "component_groups": ["eat_carrot"]
        },
        "remove": {
          "component_groups": ["move", "start_eating"]
        },
        "queue_command": {
          "command": ["effect @s regeneration 5 2 true"]
        }
      },
      "stop_eating": {
        "add": {
          "component_groups": ["move"]
        },
        "remove": {
          "component_groups": ["eat_carrot"]
        }
      }
    }
  }
}
