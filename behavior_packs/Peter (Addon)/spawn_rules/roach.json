{
  "format_version": "1.12.0",
  "minecraft:spawn_rules": {
    "description": {
      "identifier": "addon:roach",
      "population_control": "ambient"
    },
    "conditions": [
      {
        "minecraft:spawns_underground": {},

        "minecraft:spawns_on_block_filter": ["minecraft:cobblestone", "minecraft:stone", "minecraft:deepslate"],

        "minecraft:brightness_filter": {
          "min": 0,
          "max": 7,
          "adjust_for_weather": true
        },

        "minecraft:weight": {
          "default": 30
        },

        "minecraft:herd": {
          "min_size": 1,
          "max_size": 3
        },

        "minecraft:density_limit": {
          "underground": 10
        },

        "minecraft:biome_filter": {
          "test": "has_biome_tag",
          "operator": "==",
          "value": "caves"
        }
      }
    ]
  }
}
