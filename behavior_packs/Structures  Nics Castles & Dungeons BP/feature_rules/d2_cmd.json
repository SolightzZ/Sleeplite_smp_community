{
  "format_version": "1.20.0",
  "minecraft:feature_rules": {
    "description": {
      "identifier": "ncd:d2_cmd",
      "places_feature": "ncd:d2_cmd"
    },
    "conditions": {
      "placement_pass": "surface_pass",
      "minecraft:biome_filter": [
        {
          "all_of": [
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "overworld"
            },
            {
              "test": "has_biome_tag",
              "operator": "!=",
              "value": "frozen"
            },
            {
              "test": "has_biome_tag",
              "operator": "!=",
              "value": "ocean"
            },
            {
              "test": "has_biome_tag",
              "operator": "!=",
              "value": "river"
            }
          ]
        }
      ]
    },
    "distribution": {
      "iterations": 1,
      "scatter_chance": {
        "numerator": 1,
        "denominator": 1500
      },
      "x": {
        "distribution": "uniform",
        "extent": [0, 16]
      },
      "y": "query.heightmap(variable.worldx, variable.worldz)",
      "z": {
        "distribution": "uniform",
        "extent": [0, 16]
      }
    }
  }
}
