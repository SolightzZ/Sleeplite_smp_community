{
  "format_version": "1.21.0",
  "minecraft:feature_rules": {
    "description": {
      "identifier": "tayi:jungle_plants_rule",
      "places_feature": "tayi:jungle_plants"
    },
    "conditions": {
      "placement_pass": "before_sky_pass",
      "minecraft:biome_filter": [
        {
          "all_of": [
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "jungle"
            }
          ]
        }
      ]
    },
    "distribution": {
      "iterations": "math.random_integer(8, 14)",
      "coordinate_eval_order": "zxy",
      "x": {
        "distribution": "uniform",
        "extent": [0, 15]
      },
      "y": "query.heightmap(variable.worldx, variable.worldz) + 0",
      "z": {
        "distribution": "uniform",
        "extent": [0, 15]
      }
    }
  }
}
